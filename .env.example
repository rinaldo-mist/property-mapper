# Copy to .env and fill in. Never commit .env.

# ── Database ──────────────────────────────────────────────────────────────────
# Local dev (docker-compose.yml). Port 5433, not 5432: the compose stack stays
# out of the way of any PostgreSQL already installed on the host.
DATABASE_URL=postgres://mapper:mapper@localhost:5433/mapper?sslmode=disable
# Production (Neon, ap-southeast-1). Use the DIRECT endpoint, not -pooler: Cloud Run
# holds a warm pool, so prepared statements work and PgBouncer is unnecessary.
# Keep pool_max_conns * Cloud Run --max-instances inside Neon's connection limit.
#   DATABASE_URL=postgres://USER:PASS@ep-xxx.ap-southeast-1.aws.neon.tech/mapper?sslmode=require&pool_max_conns=5

# ── HTTP ──────────────────────────────────────────────────────────────────────
# Cloud Run injects PORT; locally it defaults to 8080.
PORT=8080
APP_ENV=development                 # development | production
LOG_LEVEL=info                      # debug | info | warn | error

# Browsers reach the API same-origin through the Next.js rewrite proxy, so this
# stays empty in production. Only set it if something must call the API cross-origin.
CORS_ALLOWED_ORIGINS=

# ── Auth ──────────────────────────────────────────────────────────────────────
# Must be >= 32 bytes or the server refuses to boot.  Generate with:
#   openssl rand -base64 48
AUTH_JWT_SECRET=
AUTH_COOKIE_SECURE=false            # MUST be true when APP_ENV=production
AUTH_SESSION_TTL=12h

# ── Frontend (web/.env.local) ─────────────────────────────────────────────────
# Server-side only: the rewrite proxy target. NOT a NEXT_PUBLIC_ var — baking the
# API hostname into the client bundle is exactly what the proxy exists to avoid.
API_INTERNAL_URL=http://localhost:8080
